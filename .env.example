POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_DB=flashsale
POSTGRES_PORT=5432

REDIS_PORT=6379

# Sale window in ISO 8601. Defaults: start = API boot time, end = start + 1 hour.
# Only applied when no sale is configured in Redis yet.
SALE_START_AT=
SALE_END_AT=
# Initial stock, non-negative integer. Default: 100
SALE_STOCK=
# Product identifier. Default: flash-sale-item
PRODUCT_ID=
# Enables POST /api/admin/sale ("true" or "false"). Default: true
ADMIN_ENABLED=
